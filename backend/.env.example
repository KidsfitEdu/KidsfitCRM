# Initial bootstrap (Development / disposable DB only):
# Set these privately in backend/.env before running --migrate --seed-initial.
# Use separate strong passwords (12+ chars), never commit real credentials.
# Seed__AdminPassword=
# Seed__BoardPassword=
# Seed__CheckeePassword=

# Demo seed is opt-in only on a verified disposable MySQL database.
# Supply Seed__DemoPassword privately (do not commit real values).
# Demo seed
Seed__DemoEnabled=false
Seed__DisposableDatabase=true
Seed__ReviewFixtures=true
Seed__Nt01Scenarios=true
Seed__AccountingScenarios=false
Seed__DemoPassword=Kidsfit@2026
Seed__ProtectionRenewalScenarios=true
Seed__Gi01Scenarios = true

GI01__EnableAutomaticRelease = false

# File uploads: automatic default in Development is <API content root>/Storage.
# Windows Production default is %ProgramData%\KidsfitCRM\Storage.
# Override only when you need another persistent location outside publish/wwwroot:
# Storage__RootPath=D:\KidsfitCRM\Storage\Evidence
# Optional: maximum evidence file size in MB (default 5; accepted range 1..100).
# Storage__MaxFileSizeMB=5
Seed__Gi01SweepAfterSeed = false

ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=kidsfit_crm;User=kidsfit_crm;Password=kidsfit_secret;Character Set=utf8mb4;
Jwt__Issuer=KidsfitCRM.Api
Jwt__Audience=KidsfitCRM.Web
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes
Cors__Origins__0=http://localhost:3000

# Password reset SMTP (Gmail). Never commit an actual App Password.
# Enable Google 2-step verification and generate a Google App Password.
# Configure these in production server secrets, not in frontend NEXT_PUBLIC_*.
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=kidsfit.education@gmail.com
Smtp__From=kidsfit.education@gmail.com
# Smtp__AppPassword=
# Optional: publicly accessible HTTPS logo PNG/SVG URL (some email clients may block SVG).
# Smtp__LogoUrl=https://YOUR_PUBLIC_CRM_DOMAIN/branding/kidsfit-logo.png
# REQUIRED for OTP in production, at least 32 random bytes. Different from JWT key.
# PasswordReset__HmacKey=
