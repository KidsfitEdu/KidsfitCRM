# Initial bootstrap (Development / disposable DB only):
# Set these privately in backend/.env before running --migrate --seed-initial.
# Use separate strong passwords (12+ chars), never commit real credentials.
# Seed__AdminPassword=
# Seed__BoardPassword=
# Seed__CheckeePassword=

# Demo seed is opt-in only on a verified disposable MySQL database.
# Supply Seed__DemoPassword privately (do not commit real values).
# Demo seed
Seed__DemoEnabled=false
Seed__DisposableDatabase=true
Seed__ReviewFixtures=true
Seed__Nt01Scenarios=true
Seed__AccountingScenarios=false
Seed__DemoPassword=Kidsfit@2026
Seed__ProtectionRenewalScenarios=true
Seed__Gi01Scenarios = true

GI01__EnableAutomaticRelease = false
Seed__Gi01SweepAfterSeed = false

ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=kidsfit_crm;User=kidsfit_crm;Password=kidsfit_secret;Character Set=utf8mb4;
Jwt__Issuer=KidsfitCRM.Api
Jwt__Audience=KidsfitCRM.Web
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes
Cors__Origins__0=http://localhost:3000
