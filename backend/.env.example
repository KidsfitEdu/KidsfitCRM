# Only use an isolated, expendable MySQL database for fictional training data.
Seed__DemoEnabled=false
Seed__DisposableDatabase=false
Seed__ReviewFixtures=false
Seed__AccountingScenarios=false
# Supply Seed__DemoPassword privately at runtime.
# The review fixture comes from src/KidsfitCRM.Api/SeedData/crm-review-data.json.
# There is no Excel import for this profile.
ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=kidsfit_crm_review;User=kidsfit_crm;Password=replace-locally;Character Set=utf8mb4;
Jwt__Issuer=KidsfitCRM.Api
Jwt__Audience=KidsfitCRM.Web
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes
Cors__Origins__0=http://localhost:3000
