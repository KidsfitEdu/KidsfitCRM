# Disposable training data is OFF by default. Never reuse these settings on a real database.
Seed__DemoEnabled=false
Seed__DisposableDatabase=false
Seed__TenSchoolScenario=false
Seed__AccountingScenarios=false
# Provide Seed__DemoPassword privately at runtime; never commit a real value.
# Optional PRIVATE file path when TenSchoolScenario=true:
# Seed__SchoolWorkbookPath=C:\\private\\CRM_10_Truong_Hoc.xlsx

ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=kidsfit_crm;User=kidsfit_crm;Password=replace-locally;Character Set=utf8mb4;
Jwt__Issuer=KidsfitCRM.Api
Jwt__Audience=KidsfitCRM.Web
Jwt__Key=replace-with-a-random-secret-of-at-least-32-bytes
Cors__Origins__0=http://localhost:3000
