# Development-only illustration. Copy to backend/.env and supply LOCAL secrets privately.
# Do not commit backend/.env or reuse any example credentials on a shared server.
# Runtime refuses --seed-demo. Bootstrap is only --migrate --seed-initial on
# an isolated Development DB with Seed__DisposableDatabase=true.
Seed__DemoEnabled=false
Seed__DisposableDatabase=false
# Seed__AdminPassword=<private strong password>
# Seed__BoardPassword=<private strong password>
# Seed__CheckeePassword=<private strong password>
GI01__EnableAutomaticRelease=false

# REQUIRED: real values must be provided locally or by deployment secret management.
ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=kidsfit_crm;User=<db_user>;Password=<db_secret>;Character Set=utf8mb4;
Jwt__Issuer=KidsfitCRM.Api
Jwt__Audience=KidsfitCRM.Web
Jwt__Key=
Cors__Origins__0=http://localhost:3000

# Optional private evidence storage outside wwwroot; mount durable storage for production.
# Storage__RootPath=<absolute-private-directory>
# Storage__MaxFileSizeMB=5
# Password recovery SMTP; supply private App Password and independent HMAC signing secret.
# Smtp__Host=smtp.gmail.com
# Smtp__Port=587
# Smtp__Username=<smtp_user>
# Smtp__From=<verified_sender>
# Smtp__AppPassword=<private-app-password>
# PasswordReset__HmacKey=<independent-random-secret-at-least-32-bytes>
